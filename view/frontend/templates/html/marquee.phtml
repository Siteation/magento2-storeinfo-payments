<?php declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;
use Siteation\IconsPayment\ViewModel\PaymentIcons;
use Siteation\IconsPayment\ViewModel\PaymentIconsMono;
use Siteation\IconsPayment\ViewModel\PaymentIconsFlat;
use Siteation\StoreInfoPayments\ViewModel\StorePayments;

/** @var Template $block */
/** @var Escaper $escaper */

/** @var PaymentIcons $paymentIcons */
$paymentIcons = $block->getPaymentIcons();

/** @var PaymentIconsMono $paymentIconsMono */
$paymentIconsMono = $block->getPaymentIconsMono();

/** @var PaymentIconsFlat $paymentIconsFlat */
$paymentIconsFlat = $block->getPaymentIconsFlat();

/** @var StorePayments $storePayments */
$storePayments = $block->getStoreInfoPayments();

$paymentOptions = $storePayments->getPaymentMethods();

$blockId = $block->getBlockId() ?? "siteation-marquee-footer";

$gap = $block->getData('gap') ?: 2;
$duration = $block->getData('duration') ?: 40;
$reverse = $block->getData('reverse') !== null ? $block->getData('reverse') : false;

$iconStyle = $block->getIconStyle() ?: $storePayments->getIconStyle() ?: 'default';
$iconWidth = (int) $block->getIconWidth() ?: 64;
$iconHeight = (int) $block->getIconHeight() ?: 48;

$headingText = $block->getHeading() ?: __('Payment Methods');

$cssClasses = $block->getCssClasses() ?: 'storeinfo payment-marquee';
$headingCssClasses = $block->getHeadingCssClasses() ?: 'payment-title';

if (!$paymentOptions) {
    return '';
}
?>

<aside
    id="<?= $escaper->escapeHtmlAttr($blockId) ?>"
    class="<?= $escaper->escapeHtmlAttr($cssClasses) ?>"
    aria-label="<?= $escaper->escapeHtmlAttr($headingText) ?>"
>
    <p class="<?= $escaper->escapeHtmlAttr($headingCssClasses) ?>">
        <strong><?= $escaper->escapeHtml($headingText) ?></strong>
    </p>

    <div class="marquee-section">
        <ul role="list" class="marquee-row">
            <?php foreach ($paymentOptions as $option): ?>
                <li>
                    <?= match ($iconStyle) {
                        'mono' => $paymentIconsMono->renderHtml($option, '', $iconWidth, $iconHeight, ["title" => __('Logo %1', $option)]),
                        'flat' => $paymentIconsFlat->renderHtml($option, '', $iconWidth, $iconHeight, ["title" => __('Logo %1', $option)]),
                        'default' => $paymentIcons->renderHtml($option, '', $iconWidth, $iconHeight, ["title" => __('Logo %1', $option)])
                    } ?>
                </li>
            <?php endforeach; ?>
        </ul>
        <div aria-hidden="true" class="marquee-row">
            <?php foreach ($paymentOptions as $option): ?>
                <?= match ($iconStyle) {
                    'mono' => $paymentIconsMono->renderHtml($option, '', $iconWidth, $iconHeight, ["title" => __('Logo %1', $option)]),
                    'flat' => $paymentIconsFlat->renderHtml($option, '', $iconWidth, $iconHeight, ["title" => __('Logo %1', $option)]),
                    'default' => $paymentIcons->renderHtml($option, '', $iconWidth, $iconHeight, ["title" => __('Logo %1', $option)])
                } ?>
            <?php endforeach; ?>
        </div>
    </div>

    <style>
        /* Per-block configuration. The rest of the marquee lives in the stylesheet. */
        :where(#<?= $escaper->escapeHtml($blockId) ?>) {
            --gap: <?= $escaper->escapeHtml($gap) ?>rem;
            --duration: <?= $escaper->escapeHtml($duration) ?>s;
            <?php if ($reverse): ?>--direction: reverse;<?php endif; ?>
        }
    </style>
</aside>
